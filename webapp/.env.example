# Prisma が参照するDB接続先（SQLite）
DATABASE_URL="file:./dev.db"

# セッションCookieの署名鍵（必ずランダムな値に変更）
SESSION_SECRET="change-me-to-a-long-random-string"

# 初期ログインアカウントのパスワード（seed投入時に使用）
SEED_STAFF_PASSWORD="change-me"

# エージェントAPI連携（フェーズ5）。会社のClaude Consoleアカウントのキーを使う。
# このファイルはコミットしない（.env は .gitignore 済み）。
ANTHROPIC_API_KEY=""
