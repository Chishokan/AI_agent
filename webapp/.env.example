# DBファイルの場所（node:sqlite）。未設定なら webapp/data/app.db
DATABASE_PATH="./data/app.db"

# セッションCookieの署名鍵（必ずランダムな長い文字列に変更）
SESSION_SECRET="change-me-to-a-long-random-string"

# 初期ログインアカウントのパスワード（db:init 投入時に使用）
SEED_STAFF_PASSWORD="change-me"

# エージェントAPI連携（フェーズ5）。会社のClaude Consoleアカウントのキー。
ANTHROPIC_API_KEY=""
