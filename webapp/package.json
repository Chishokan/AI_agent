{
  "name": "chishokan-nep-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "校門配布 計画/実績 入力Webアプリ + エージェントAPI連携（智翔館NEP）",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite next dev",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--experimental-sqlite next start",
    "lint": "next lint",
    "db:init": "node --experimental-sqlite db/init.mjs",
    "db:init:seed": "node --experimental-sqlite db/init.mjs --seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "bcryptjs": "^2.4.3",
    "cross-env": "^7.0.3",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
